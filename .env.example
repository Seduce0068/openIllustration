# openIllustration の環境変数テンプレート（すべてダミー値）。
# 秘密情報は秘密管理基盤から注入し、このファイルを本番で使わないこと。
# 詳細は README / docs/OPERATIONAL_POLICY.md / 各 Runbook を参照。

# --- サーバー起動時に必須（本番） ---
# 32 バイト以上のランダム値。未設定・短すぎると起動拒否（値は非エコー）。
JWT_SECRET=replace-with-32-byte-random-secret-value
DATABASE_URL=file:/var/lib/openillustration/local.db
# リモート DSN は本番ゲートで拒否。DATABASE_TOKEN は環境変数のみ（argv 拒否・非エコー）。
DATABASE_TOKEN=
ALLOW_MOCK_AUTH=0
ALLOW_IPV4_LOCALHOST=0
ALLOWED_ORIGINS=https://app.example.org
# リスナのバインド先。未設定時は [::]:3000。IP として不正な値・特権ポート（<1024）・
# 範囲外のポートは固定文言で起動拒否（値はエコーしない）。
BIND_ADDR=::
PORT=3000
AUDIT_EXPECT_ROOT=

# マイグレーション SQL 配置ディレクトリ（絶対パス必須）。未設定時は ./migrations 等を探索。
MIGRATIONS_DIR=

# --- JWT / OIDC（本番は HTTPS・userinfo 無し） ---
# RS256 を使う場合のみ以下3行を有効化（HS256 のまま併用すると起動拒否）。
# JWT_RSA_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----...
# JWT_RSA_VERIFICATION_KEYS={"kid":"-----BEGIN PUBLIC KEY-----..."}
# JWT_REQUIRE_KID=1
OIDC_ISSUER=https://issuer.example.org
OIDC_JWKS_URI=https://issuer.example.org/.well-known/jwks.json
OIDC_AUTHORIZATION_ENDPOINT=https://issuer.example.org/authorize
OIDC_TOKEN_ENDPOINT=https://issuer.example.org/token
OIDC_CLIENT_ID=openillustration
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_REDIRECT_URI=https://api.example.org/auth/oidc/callback
OIDC_SCOPES=openid
OIDC_REQUIRED_ACR=
OIDC_REQUIRED_AMR=
OIDC_MAX_AUTH_AGE_SECS=86400
OIDC_CLOCK_SKEW_SECS=60
OIDC_COOKIE_SECURE=1
OIDC_HTTP_TIMEOUT_SECS=15

# --- 年齢/地域ポリシー（AGE_TARGET_REGIONS / TZ は doctor 診断対象） ---
AGE_TARGET_REGIONS=JP
AGE_COUNTRY_OVERRIDES=
AGE_DEFAULT_MINIMUM=21
AGE_ENFORCEMENT_MODE=self_reported
# 信頼属性必須モード（trusted_attribute_required / trusted_attribute）では1つ以上必須。
AGE_TRUSTED_ISSUERS=
AGE_REQUIRE_EXPLICIT_CONFIGURATION=1
TZ=Asia/Tokyo

# --- IPFS / 決済（本番は HTTPS、秘密は環境変数のみ） ---
IPFS_GATEWAYS=https://gateway.example.org/ipfs/{cid}
IPFS_TIMEOUT_SECS=15
IPFS_MAX_ATTEMPTS=1
PINATA_JWT=replace-with-pinata-jwt
PAYMENT_RECEIVING_ADDRESS=0x1111111111111111111111111111111111111111
PAYMENT_RECEIVING_XPRV=

# --- 観測・制限・運用 ---
RUST_LOG=info
LOG_FORMAT=json
EXPOSE_INTERNAL_ERRORS=0
RATE_LIMIT_PER_MIN=60
MAX_CONCURRENT_REQUESTS=256
TRUSTED_PROXY_CIDRS=
GRACEFUL_DRAIN_TIMEOUT_SECS=30
REQUEST_TIMEOUT_SECS=30
MODERATION_FINALIZE_INTERVAL_SECS=60
MODERATION_OPERATOR_HASHES=

# --- バックアップ / 監査エクスポート（CLI 用・cron ラッパー allowlist 対象） ---
BACKUP_DIR=/var/backups/openillustration
BACKUP_PREFIX=openillustration
RETENTION_DAYS=30
MIN_KEEP=3
ALLOW_UNENCRYPTED_BACKUP=0
BACKUP_GPG_RECIPIENT=replace-with-gpg-recipient
ALERT_CMD=
OFFSITE_COPY_CMD=
OFFSITE_DEST=

# --- ビルド時変数（クライアント wasm。Rust の option_env! でコンパイル時に埋め込まれる） ---
# 本番は HTTPS オリジンを必須で指定する（未設定だと開発用 http://localhost:3000 が埋まる）。
OIL_API_BASE=https://api.example.org
OIL_MOCK_AUTH=0
OIL_CLIENT_METRICS=1

# --- CLI / スクリプト固有 ---
# 監査エクスポートで平文理由を含める破格運用（既定はマスク。本番は明示オプトインのみ）。
AUDIT_EXPORT_INCLUDE_REASONS=
BACKUP_ENV_FILE=/etc/openillustration/backup.env
GPG_BIN=gpg
FIND_BIN=find
