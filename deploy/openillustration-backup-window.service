[Unit]
# オフサイト転送はネットワークを必要とするため、確立後に実行する。
After=network-online.target
Wants=network-online.target
Description=OpenIllustration database backup window (stop -> backup -> start)
# バックアップ失敗・アプリ起動失敗の両方でアラート unit を起動する。
# 配置時に <実宛先へ通知する unit> へ差し替えること（ALERT_CMD は backup-rotate.sh 側）。
OnFailure=openillustration-backup-alert.service
Documentation=file:///opt/openIllustration/docs/BACKUP_RESTORE_RUNBOOK.md

[Service]
Type=oneshot
# oneshot の既定は無期限。GPG / オフサイト転送のハングで ExecStart が返らないと
# ExecStopPost が走らずアプリが停止したままになるため、上限を設定する。
TimeoutStartSec=1800
WorkingDirectory=/opt/openIllustration

# APP_UNIT は設定可能値。deploy/openillustration.service を同梱しているため、
# 導入環境の実 unit 名へ合わせる（例: systemctl edit の drop-in で
# [Service] 節に Environment=APP_UNIT=<実 unit 名> を置いて上書き）。
Environment=APP_UNIT=openillustration.service

Environment=BACKUP_DIR=/var/backups/openillustration
Environment=BIN_DIR=/opt/openIllustration/target/release
Environment=RETENTION_DAYS=30
Environment=MIN_KEEP=3
# DATABASE_URL は backup.env で server.env と同じ絶対 file: パスを設定すること。
# ここで既定を上書きすると server.env 変更時に旧 DB をバックアップしてしまう。
# BACKUP_GPG_RECIPIENT（必須）と AUDIT_EXPECT_ROOT（本番必須）、ALERT_CMD /
# OFFSITE_* は 600 権限の環境ファイルで管理する。
# AUDIT_EXPECT_ROOT は別経路保存の Merkle root（hex、非機微）。設定時は
# verify_audit_log --expect-root で外部 root と照合し、未設定時は内部整合性
# チェックのみ（既存運用を壊さない後方互換）。値はエラー文言へエコーしない。
# 環境ファイルの解釈は cron 版と異なる: cron 版は backup-cron-wrapper.sh の
# 制限付き KEY=VALUE パーサ（source/eval なし、値はリテラル）で読み込み、
# systemd 版は EnvironmentFile= で読み込む。両者で共通の KEY=VALUE 形式のみを使い、
# コマンド置換・クォート展開・行継続などのシェル記法は記述しないこと。
EnvironmentFile=-/etc/openillustration/backup.env

# '+' は User=/Group= を無視して root で実行する systemd の Exec 接頭辞。
# systemctl によるアプリ unit の停止/起動に sudoers / polkit の権限付与を行わない。
# backup-rotate.sh 自体は User= の openillustration で実行し、成果物所有者を維持する。
ExecStartPre=+/usr/bin/systemctl stop ${APP_UNIT}
ExecStart=/opt/openIllustration/scripts/backup-rotate.sh
# oneshot の ExecStopPost は ExecStartPre / ExecStart の成否にかかわらず必ず実行される。
# バックアップ失敗時もアプリ unit の起動を保証するため、起動は ExecStart ではなく
# ここに置く。起動が失敗した場合は unit 結果が失敗となりアラート対象とする。
ExecStopPost=+/usr/bin/systemctl start ${APP_UNIT}

User=openillustration
Group=openillustration
# 生成するバックアップ/一時ファイルの既定権限を 0600 に制限する
# （cron 版は backup-rotate.sh 内の umask 077 で同等に制限する）。
UMask=0077
# SyslogIdentifier は journald の検索タグ（通知先ではない）。変更しても通知は飛ばない。
# バックアップ失敗は ALERT_CMD、再起動失敗は本 unit の失敗結果を監視して通知する。
SyslogIdentifier=openillustration-backup-window
